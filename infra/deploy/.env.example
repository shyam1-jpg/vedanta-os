# Copy to .env and fill in. Never commit .env.
DOMAIN=admin.thevedanta.org          # DNS A record must point at this server before first start
DB_PASSWORD=change-me-long-random

# Microsoft 365 sign-in (Entra ID app registration — see docs/deploy.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Outbound email (optional). Without it, emails are saved to the log for staff to copy.
# Department inboxes for guest bookings, and the maintenance, general manager and kitchen
# addresses for fault reports, are set in House → Settings, not in this file.
# Leave those blank in git. SMTP_URL is what sends them; unset means each note is only logged.
# Microsoft 365: smtp://bookings%40thevedanta.org:APP_PASSWORD@smtp.office365.com:587  (needs SMTP AUTH enabled on the mailbox)
# Once set, guest access codes are emailed automatically on registration and enquiry.
SMTP_URL=
MAIL_FROM=Vedanta Oway Retreat <bookings@thevedanta.org>

# Card payments stay off until this is true. Food is not billed. The reception shop is a later phase.
# Card numbers and security codes are never stored. Stripe holds the card.
PAYMENTS_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required in production. Encrypts guest diet notes and staff personal and bank details.
FIELD_ENCRYPTION_KEY=

# Local development door only. Refused when NODE_ENV=production or the database is hosted.
ALLOW_DEV_LOGIN=
DEV_LOGIN_SECRET=

# Kiteline stays off unless this is true, and then the body is signed and minimal.
KITELINE_BACKUP=
KITELINE_SECRET=

# AI Duty Manager (optional). Set to enable natural language house queries and morning briefings.
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
